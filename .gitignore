.DS_Store
Thumbs.db

# Data files (too large for git)
data/raw/*.parquet
data/raw/*.csv
data/processed/*.parquet
data/processed/*.csv
data/features/*.parquet
data/features/*.csv

# But keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/features/.gitkeep

# Model artifacts (too large for git)
models/*.bin
models/*.onnx
models/*.pt

# Production model binaries required by CI
!models/rain_rf_model.bin
!models/rain_bagging_ensemble.bin

# But keep directory structure
!models/.gitkeep

